---
import { getCollection } from "astro:content";
import { formatDates } from "../lib/dates.ts";

const roles = (await getCollection("roles")).sort(
  (a, b) => a.data.order - b.data.order,
);
const large = roles.filter((r) => r.data.size === "large");
const small = roles.filter((r) => r.data.size === "small");

// Full class names so Tailwind can see them. Stories reuse the same tints (#8).
const tintClass = {
  peach: "bg-tint-peach",
  mint: "bg-tint-mint",
  sky: "bg-tint-sky",
  lilac: "bg-tint-lilac",
} as const;

const groups = [
  { cards: large, grid: "grid gap-4" },
  { cards: small, grid: "grid gap-4 md:grid-cols-3 md:items-start" },
];
---

<section
  id="work"
  aria-labelledby="work-heading"
  class="mx-auto max-w-4xl px-6 py-16"
  data-testid="work"
>
  <h2
    id="work-heading"
    class="font-display text-step-2 font-medium leading-tight tracking-tight"
  >
    Work
  </h2>
  <div class="mt-6 grid gap-4">
    {
      groups.map((group) => (
        <ul class={`m-0 list-none p-0 ${group.grid}`}>
          {group.cards.map(({ data: role }) => (
            <li
              class={`role-card rounded-xl border border-edge/40 ${tintClass[role.tint]} text-ink`}
              data-testid={`role-card-${role.id}`}
              data-size={role.size}
            >
              <details>
                <summary class="role-summary flex min-h-11 cursor-pointer list-none items-start justify-between gap-3 rounded-xl p-5">
                  <span class="block">
                    <h3
                      class={`font-display font-medium leading-tight tracking-tight ${role.size === "large" ? "text-step-3" : "text-step-1"}`}
                    >
                      {role.org}
                    </h3>
                    <span class="mt-1 block text-step-0">{role.title}</span>
                    <span class="block text-step--1 text-ink-soft">
                      {formatDates(role)}
                    </span>
                    <span class="mt-3 block max-w-prose text-step-0">
                      {role.scope}
                    </span>
                  </span>
                  <svg
                    class="role-chevron mt-1 size-5 shrink-0"
                    viewBox="0 0 20 20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M5 8l5 5 5-5" />
                  </svg>
                </summary>
                <div class="role-detail px-5 pb-5">
                  <p class="text-step--1 text-ink-soft">{role.location}</p>
                  {role.context && (
                    <p class="mt-3 max-w-prose text-step-0">{role.context}</p>
                  )}
                  <ul class="mt-3 list-disc space-y-2 pl-5 text-step-0">
                    {role.claims.map((claim) => (
                      <li class="max-w-prose">{claim.text}</li>
                    ))}
                  </ul>
                </div>
              </details>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</section>
