---
import { getCollection } from "astro:content";
import { formatDates } from "../lib/dates.ts";
import CompanyLogo from "./CompanyLogo.astro";
import SectionHeading from "./SectionHeading.astro";

const roles = (await getCollection("roles")).sort(
  (a, b) => a.data.order - b.data.order,
);
const tintClass = {
  peach: "bg-tint-peach",
  mint: "bg-tint-mint",
  sky: "bg-tint-sky",
  lilac: "bg-tint-lilac",
} as const;
const layout = {
  owner: "min-[761px]:col-span-2 min-[761px]:grid-cols-[.8fr_1.2fr]",
  faire:
    "min-[761px]:row-span-2 min-[761px]:grid-rows-subgrid min-[761px]:gap-y-0",
  shopify:
    "min-[761px]:row-span-2 min-[761px]:grid-rows-subgrid min-[761px]:gap-y-0",
  textnow: "min-[761px]:col-span-2 min-[761px]:grid-cols-2",
};
---
<section id="work" aria-labelledby="work-heading" class="mx-5 mt-12 max-w-[1100px] min-[1140px]:mx-auto" data-testid="work">
  <SectionHeading id="work-heading" title="Work" eyebrow="01 / Experience" caption="From design doc to rollout." />
  <ul class="m-0 grid list-none gap-5 p-0 min-[761px]:grid-cols-2 min-[761px]:gap-[22px]">
    {roles.map(({data: role}, i) => {
      const visible = role.id === "owner" ? 2 : 1;
      const more = role.claims.slice(visible);
      return (
        <li class={`role-card grid min-w-0 rounded-[30px] bg-surface outline outline-edge/50 forced-colors:outline-[CanvasText] ${layout[role.id as keyof typeof layout] ?? ""}`} data-testid={`role-card-${role.id}`} data-size={role.size}>
          <div class={`role-identity relative min-w-0 rounded-t-[30px] p-6 min-[761px]:px-[30px] min-[761px]:py-[26px] ${tintClass[role.tint]} ${role.id === "owner" || role.id === "textnow" ? "min-[761px]:rounded-tr-none min-[761px]:rounded-bl-[30px]" : ""}`}>
            <div class="mb-2 flex min-h-14 items-center justify-between gap-4">
              <p class="text-[11px] font-semibold uppercase tracking-[.08em]">{role.id === "owner" ? "Current role" : `${String(i+1).padStart(2,"0")} / Experience`}</p>
              {role.id !== "faire" && <CompanyLogo company={role.id} />}
            </div>
            <h3 class={`my-3 font-display text-[40px] font-semibold leading-[1.15] tracking-[-.06em] min-[761px]:text-[45px] ${role.id === "shopify" ? "font-[750] italic" : role.id === "faire" ? "flex min-h-[52px] items-center" : ""}`}>
              {role.id === "faire" ? <><img src="/images/logos/faire.svg" width="184" height="23" alt="Faire" loading="lazy" decoding="async" class="block h-auto max-w-full [[data-theme=dusk]_&]:invert [[data-theme=night]_&]:invert forced-colors:hidden" /><span class="hidden forced-colors:inline">Faire</span></> : role.org}
            </h3>
            <p class="text-[18px] font-semibold leading-[1.35]">{role.title}</p>
            <p class="mt-3 text-[14px] leading-relaxed text-ink-soft">{formatDates(role)}<br />{role.location}</p>
            <p class="mt-6 max-w-[40ch] text-[17px] leading-[1.5]">{role.scope}</p>
          </div>
          <div class="flex min-w-0 flex-col p-6 min-[761px]:px-[30px] min-[761px]:py-7">
            <p class="mb-5 text-[12px] font-semibold uppercase tracking-[.08em] text-ink-soft">{role.id === "owner" ? "Selected work" : "The work"}</p>
            <ul class="m-0 list-none space-y-5 p-0 text-[17px] leading-[1.6] min-[761px]:text-[18px]">
              {role.claims.slice(0,visible).map(claim => <li class="relative max-w-[65ch] pl-5"><span aria-hidden="true" class="absolute left-0 top-0">↗</span>{claim.text}</li>)}
            </ul>
            {more.length > 0 && <details class="mt-auto pt-6">
              <summary class="role-summary flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 border-0 border-t border-solid border-edge pt-2 text-accent underline underline-offset-4">
                More at {role.org}<span class="role-plus inline-block text-[26px] leading-none no-underline" aria-hidden="true">+</span>
              </summary>
              <ul class="role-detail m-0 mt-4 list-none space-y-5 p-0 text-[17px] leading-[1.6] min-[761px]:text-[18px]">
                {more.map(claim => <li class="relative max-w-[65ch] pl-5"><span aria-hidden="true" class="absolute left-0 top-0">↗</span>{claim.text}</li>)}
              </ul>
            </details>}
          </div>
        </li>
      );
    })}
  </ul>
</section>
