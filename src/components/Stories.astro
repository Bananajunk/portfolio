---
import { getCollection } from "astro:content";
import { publicSources, storyParts } from "../lib/stories.ts";
import SectionHeading from "./SectionHeading.astro";
import UtensilsFigure from "./UtensilsFigure.astro";

const roles = await getCollection("roles");
const cards = (await getCollection("stories"))
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ data: story }) => {
    const role = roles.find((r) => r.data.id === story.role);
    if (!role) throw new Error(`Unknown Role ${story.role}`);
    const parts = storyParts(story);
    return { story, role: role.data, parts, cites: publicSources(parts) };
  });
const stages = [
  { title: "Find the barriers", detail: "External audits" },
  { title: "Address the root cause", detail: "Remediation" },
  { title: "Keep checking", detail: "Automated release audits" },
];
---
<section id="stories" aria-labelledby="stories-heading" class="mx-5 mt-12 max-w-[1100px] min-[1140px]:mx-auto" data-testid="stories">
  <SectionHeading id="stories-heading" title="Stories" eyebrow="02 / A closer look" caption="The work, in detail." mint />
  <ol class="m-0 grid list-none gap-7 p-0">
    {cards.map(({story,role,parts,cites},i)=>{
      const flow=story.id==="flow-2";
      const utensils=story.id==="include-utensils";
      return <li class="min-w-0">
        <article class={`story grid min-w-0 rounded-[32px] border border-solid border-edge/50 bg-surface ${flow?"":utensils?"min-[761px]:grid-cols-2":"min-[761px]:grid-cols-[39%_minmax(0,1fr)]"}`} aria-labelledby={`story-${story.id}-title`} data-testid={`story-${story.id}`}>
          <div class={`relative isolate min-w-0 rounded-t-[31px] p-[25px] ${flow?"bg-tint-mint min-[761px]:px-9 min-[761px]:pt-[30px] pb-0 min-[761px]:pb-0":utensils?"bg-tint-peach px-5 min-[761px]:px-7 min-[761px]:pt-[30px] min-[761px]:rounded-tr-none min-[761px]:rounded-bl-[31px]":"bg-tint-lilac min-[761px]:p-[30px] min-[761px]:rounded-tr-none min-[761px]:rounded-bl-[31px]"}`}>
            {!utensils&&<span class="pointer-events-none absolute inset-0 -z-10 overflow-clip rounded-[inherit] forced-colors:hidden" aria-hidden="true" data-decoration><span class={`current-orbit absolute rounded-full border-solid ${flow?"-right-[125px] top-5 size-[170px] border-[30px] border-tint-sky min-[761px]:-right-[70px]":"-left-[150px] -bottom-[150px] size-[300px] border-[42px] border-tint-peach"}`}></span></span>}
            <div class="flex flex-wrap items-center justify-between gap-3 text-[12px]"><p class="text-[11px] font-semibold uppercase tracking-[.08em]">Story {String(i+1).padStart(2,"0")}</p><p data-testid="story-role">{role.org}</p></div>
            <h3 id={`story-${story.id}-title`} class={`mt-5 font-display text-[34px] font-semibold leading-[1.1] tracking-[-.05em] ${flow?"min-[761px]:text-[44px]":"min-[761px]:text-[38px]"}`}>{story.title}</h3>
            {flow ? <figure class="m-0 mt-7">
              <div class="story-image rounded-[16px] border border-solid border-edge/50 bg-surface px-2 py-3 min-[761px]:px-7 min-[761px]:py-8"><img src="/images/stories/flow-editor.webp" width="768" height="207" alt="The 2022 Shopify Flow editor: connected Order created and Check if cards, with the condition editor beside the workflow." loading="lazy" decoding="async" class="mx-auto block h-auto w-full max-w-[768px]" /></div>
              <figcaption class="flex flex-wrap items-center justify-between gap-x-5 py-3 text-[14px] text-ink-soft"><span>Flow editor, 2022</span>{cites.map(cite=>cite.url&&<a class="inline-flex min-h-11 items-center gap-2 text-accent underline underline-offset-4" href={cite.url} aria-label={cite.name}>Shopify Engineering<span aria-hidden="true">↗</span></a>)}</figcaption>
            </figure> : utensils ? <UtensilsFigure /> : <ol class="relative m-0 mt-9 grid list-none gap-5 p-0 before:absolute before:bottom-6 before:left-5 before:top-5 before:w-px before:bg-edge before:content-['']">{stages.map((stage,j)=><li class="relative grid grid-cols-[40px_minmax(0,1fr)] items-center gap-x-[13px] gap-y-0.5"><span class="row-span-2 grid size-10 place-items-center rounded-full border border-solid border-edge bg-surface text-[12px]" aria-hidden="true">{String(j+1).padStart(2,"0")}</span><strong class="font-display text-[18px] font-semibold leading-snug tracking-[-.025em]">{stage.title}</strong><small class="text-[13px] text-ink-soft">{stage.detail}</small></li>)}</ol>}
          </div>
          <div class={`grid min-w-0 content-center gap-6 p-[25px] min-[761px]:p-8 ${flow?"min-[761px]:grid-cols-2 min-[761px]:gap-x-10 min-[761px]:gap-y-[26px] min-[761px]:px-9 min-[761px]:py-[34px]":""}`}>
            {parts.map(part=><div data-part={part.key} class={`${part.key==="outcome"?`border-0 border-t border-solid border-edge pt-[18px] ${flow?"min-[761px]:border-0 min-[761px]:pt-0":""}`:""}`}>
              <h4 class="m-0 mb-1.5 text-[12px] font-semibold uppercase leading-relaxed tracking-[.08em] text-ink-soft">{part.label}</h4>
              <p class="max-w-[65ch] text-[17px] leading-[1.65]">{part.text}</p>
            </div>)}
          </div>
        </article>
      </li>
    })}
  </ol>
</section>
