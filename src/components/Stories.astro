---
import { getCollection } from "astro:content";
import { publicSources, storyParts } from "../lib/stories.ts";

const roles = await getCollection("roles");
const stories = (await getCollection("stories")).sort(
  (a, b) => a.data.order - b.data.order,
);

// Full class names so Tailwind can see them. Each Story reuses its Role's tint.
const tintClass = {
  peach: "bg-tint-peach",
  mint: "bg-tint-mint",
  sky: "bg-tint-sky",
  lilac: "bg-tint-lilac",
} as const;

const cards = stories.map(({ data: story }) => {
  const role = roles.find((r) => r.data.id === story.role);
  if (!role)
    throw new Error(`Story "${story.id}" names unknown role "${story.role}"`);
  const parts = storyParts(story);
  return { story, role: role.data, parts, cites: publicSources(parts) };
});
---

<section
  id="stories"
  aria-labelledby="stories-heading"
  class="mx-auto max-w-4xl px-6 py-16"
  data-testid="stories"
>
  <h2
    id="stories-heading"
    class="font-display text-step-2 font-medium leading-tight tracking-tight"
  >
    Stories
  </h2>
  <ol class="mt-6 grid list-none gap-8 p-0">
    {
      cards.map(({ story, role, parts, cites }) => (
        <li>
          <article
            class="story border-t border-edge/40 pt-6"
            aria-labelledby={`story-${story.id}-title`}
            data-testid={`story-${story.id}`}
          >
            <p
              class={`m-0 inline-block rounded-full px-3 py-1 text-step--1 text-ink ${tintClass[role.tint]}`}
              data-testid="story-role"
            >
              {role.org}
            </p>
            <h3
              id={`story-${story.id}-title`}
              class="mt-3 font-display text-step-1 font-medium leading-tight tracking-tight"
            >
              {story.title}
            </h3>
            <div class="mt-4 grid gap-5">
              {parts.map((part) => (
                <div data-part={part.key}>
                  <h4 class="m-0 text-step--1 font-medium uppercase tracking-wide text-ink-soft">
                    {part.label}
                  </h4>
                  <p class="mt-1 max-w-prose text-step-0">{part.text}</p>
                </div>
              ))}
            </div>
            {cites.length > 0 && (
              <p class="mt-5 max-w-prose text-step--1 text-ink-soft">
                Source:{" "}
                {cites.map((cite, i) => (
                  <>
                    {i > 0 && "; "}
                    {cite.url ? <a href={cite.url}>{cite.name}</a> : cite.name}
                  </>
                ))}
              </p>
            )}
          </article>
        </li>
      ))
    }
  </ol>
</section>
