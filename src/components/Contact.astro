---
import { RESUME_PDF_URL, resumePdfSize } from "../lib/resume-pdf.ts";

const size = await resumePdfSize();

// Email, LinkedIn and GitHub only. No phone number on the public Site (spec #1).
const links = [
  {
    label: "Email",
    text: "cl2reid@gmail.com",
    href: "mailto:cl2reid@gmail.com",
  },
  {
    label: "LinkedIn",
    text: "linkedin.com/in/cl2reid",
    href: "https://www.linkedin.com/in/cl2reid/",
  },
  {
    label: "GitHub",
    text: "github.com/Bananajunk",
    href: "https://github.com/Bananajunk",
  },
];
---

<footer aria-labelledby="contact-heading" class="mx-auto max-w-3xl px-6 py-16"
  data-testid="contact"
>
  <h2
    id="contact-heading"
    class="font-display text-step-3 font-extrabold leading-tight tracking-tight"
  >
    Contact
  </h2>
  <ul class="mt-4 space-y-1 text-step-1">
    {
      links.map((link) => (
        <li>
          {link.label}:{" "}
          <a class="text-accent underline underline-offset-2" href={link.href}>{link.text}</a>
        </li>
      ))
    }
    <li>
      <a class="text-accent underline underline-offset-2" href={RESUME_PDF_URL} download>
        Download my Resume (PDF, {size})
      </a>
    </li>
  </ul>
</footer>
