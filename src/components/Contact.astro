---
import { contactLinks as links } from "../lib/contact.ts";
import { RESUME_PDF_URL, resumePdfSize } from "../lib/resume-pdf.ts";

const size = await resumePdfSize();
---

<footer id="contact" aria-labelledby="contact-heading" class="mx-auto max-w-4xl px-6 py-16"
  data-testid="contact"
>
  <h2
    id="contact-heading"
    class="font-display text-step-2 font-medium leading-tight tracking-tight"
  >
    Contact
  </h2>
  <ul class="mt-5 list-none space-y-1 p-0 text-step-0">
    {
      links.map((link) => (
        <li>
          {link.label}:{" "}
          <a class="inline-flex min-h-11 items-center break-all text-accent underline underline-offset-4" href={link.href}>{link.text}</a>
        </li>
      ))
    }
    <li>
      <a class="inline-flex min-h-11 items-center break-all text-accent underline underline-offset-4" href={RESUME_PDF_URL} download>
        Download my Resume (PDF, {size})
      </a>
    </li>
    <li>
      <a class="inline-flex min-h-11 items-center text-accent underline underline-offset-4" href="#accessibility">
        Accessibility statement
      </a>
    </li>
  </ul>
</footer>
