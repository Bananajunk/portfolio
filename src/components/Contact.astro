---
import { contactLinks as links } from "../lib/contact.ts";
import { RESUME_PDF_URL, resumePdfSize } from "../lib/resume-pdf.ts";

const size = await resumePdfSize();
---

<footer id="contact" aria-labelledby="contact-heading" class="mx-auto max-w-3xl px-6 py-16"
  data-testid="contact"
>
  <h2
    id="contact-heading"
    class="font-display text-step-3 font-extrabold leading-tight tracking-tight"
  >
    Contact
  </h2>
  <ul class="mt-4 space-y-1 text-step-1">
    {
      links.map((link) => (
        <li>
          {link.label}:{" "}
          <a class="text-accent underline underline-offset-2" href={link.href}>{link.text}</a>
        </li>
      ))
    }
    <li>
      <a class="text-accent underline underline-offset-2" href={RESUME_PDF_URL} download>
        Download my Resume (PDF, {size})
      </a>
    </li>
  </ul>
</footer>
