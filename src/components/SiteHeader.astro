---
// Sticky pill nav. Only sections that exist get a link; add the next one here
// as each section lands: #7 Work (#work), #8 Stories (#stories),
// #10 Before that (#before-that), #11 Play (#play).
const links = [
  { id: "top", label: "Home" },
  // { id: "work", label: "Work" },
  // { id: "stories", label: "Stories" },
  // { id: "before-that", label: "Before that" },
  { id: "about", label: "About" },
  // { id: "play", label: "Play" },
  { id: "contact", label: "Contact" },
];
---

<header class="site-header" data-print="hide" data-testid="site-header">
  <nav aria-label="Sections" class="pill-nav" data-testid="site-nav">
    <ul class="m-0 flex list-none flex-wrap items-center gap-1 p-0">
      {
        links.map((link) => (
          <li>
            <a class="pill-link" href={`#${link.id}`} data-nav-link={link.id}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style is:global>
  @layer components {
    .site-header {
      padding: 0.75rem 1rem 0;
      display: flex;
      justify-content: center;
    }
    /* Sticky only when the viewport is roomy: a sticky bar must not cover the
       focused element at high zoom (WCAG 2.4.11, 1.4.10). */
    @media (min-width: 40rem) and (min-height: 40rem) {
      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
      }
    }
    html {
      scroll-padding-top: 5rem;
    }
    .pill-nav {
      border: 2px solid var(--c-border);
      border-radius: 999px;
      background: var(--c-surface);
      padding: 0.25rem;
    }
    .pill-link {
      display: inline-flex;
      align-items: center;
      min-block-size: 2.75rem;
      padding: 0 1rem;
      border-radius: 999px;
      color: var(--c-ink);
      font-weight: 700;
      text-decoration: none;
    }
    .pill-link:hover {
      background: var(--c-tint-lilac);
    }
    .pill-link[aria-current="true"] {
      background: var(--c-banana);
      color: var(--c-on-banana);
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }
</style>

<script>
  import "../scripts/nav";
</script>
