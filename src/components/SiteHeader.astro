---
// Quiet sticky nav. Only sections that exist get a link; add the next one here
// as each section lands: #7 Work (#work), #8 Stories (#stories),
// #10 Before that (#before-that), #11 Play (#play).
const links = [
  { id: "top", label: "Home" },
  // { id: "work", label: "Work" },
  // { id: "stories", label: "Stories" },
  // { id: "before-that", label: "Before that" },
  { id: "about", label: "About" },
  // { id: "play", label: "Play" },
  { id: "contact", label: "Contact" },
];
---

<header class="site-header mx-auto flex max-w-4xl justify-start px-6 pt-5" data-print="hide" data-testid="site-header">
  <nav aria-label="Sections" class="rounded-lg bg-bg px-1" data-testid="site-nav">
    <ul class="m-0 flex list-none flex-wrap items-center gap-1 p-0">
      {
        links.map((link) => (
          <li>
            <a class="inline-flex min-h-11 items-center rounded-sm px-3 text-step--1 text-ink-soft no-underline hover:text-ink aria-[current=true]:text-ink aria-[current=true]:underline aria-[current=true]:decoration-1 aria-[current=true]:underline-offset-8" href={`#${link.id}`} data-nav-link={link.id}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style is:global>
  @layer components {
    /* Sticky only when the viewport is roomy: a sticky bar must not cover the
       focused element at high zoom (WCAG 2.4.11, 1.4.10). */
    @media (min-width: 40rem) and (min-height: 40rem) {
      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
      }
    }
    html {
      scroll-padding-top: 5rem;
    }
  }
</style>

<script>
  import "../scripts/nav";
</script>
