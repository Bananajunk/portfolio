---
// Illustrated Bananajunk mascot: a friendly banana with a gradient, a face and
// sparkles. The wobble and twinkle live in src/styles/motion.css and switch off
// under Calm mode. The gradient is the same in every Time of day theme.
---

<svg
  class="mascot"
  viewBox="0 0 320 340"
  width="320"
  height="340"
  role="img"
  aria-labelledby="mascot-title"
  data-testid="mascot"
>
  <title id="mascot-title">Bananajunk mascot: a smiling cartoon banana with sparkles</title>
  <defs>
    <linearGradient id="mascot-skin" x1="0" y1="0" x2="1" y2="1">
      <stop class="mascot-stop-a" offset="0" />
      <stop class="mascot-stop-b" offset="0.6" />
      <stop class="mascot-stop-c" offset="1" />
    </linearGradient>
  </defs>
  <g class="mascot-body">
    <path
      class="mascot-skin"
      d="M118 40c-8-14 2-28 18-26 10 2 14 10 14 18 52 6 112 46 128 116 14 62-24 126-96 148-52 16-104 4-132-28-8-9-2-22 10-20 36 8 74 4 98-24 34-40 34-100-14-148-8-8-14-24-26-36z"
      fill="url(#mascot-skin)"
    ></path>
    <path
      class="mascot-line"
      d="M150 32c52 6 112 46 128 116 14 62-24 126-96 148"
      fill="none"
    ></path>
    <path class="mascot-tip" d="M118 40c-8-14 2-28 18-26 10 2 14 10 14 18z"></path>
    <ellipse class="mascot-eye" cx="168" cy="150" rx="9" ry="13"></ellipse>
    <ellipse class="mascot-eye" cx="222" cy="170" rx="9" ry="13"></ellipse>
    <circle class="mascot-shine" cx="171" cy="145" r="3.5"></circle>
    <circle class="mascot-shine" cx="225" cy="165" r="3.5"></circle>
    <ellipse class="mascot-blush" cx="150" cy="184" rx="14" ry="9"></ellipse>
    <ellipse class="mascot-blush" cx="240" cy="206" rx="14" ry="9"></ellipse>
    <path class="mascot-mouth" d="M184 190c8 22 32 26 44 6" fill="none"></path>
  </g>
  <g class="mascot-sparkle mascot-sparkle-1">
    <path class="mascot-star" d="M48 70l7 20 20 7-20 7-7 20-7-20-20-7 20-7z"></path>
  </g>
  <g class="mascot-sparkle mascot-sparkle-2">
    <path class="mascot-star" d="M278 36l5 14 14 5-14 5-5 14-5-14-14-5 14-5z"></path>
  </g>
  <g class="mascot-sparkle mascot-sparkle-3">
    <path class="mascot-star" d="M286 270l4 11 11 4-11 4-4 11-4-11-11-4 11-4z"></path>
  </g>
</svg>

<style is:global>
  @layer components {
    .mascot {
      inline-size: 100%;
      max-inline-size: 20rem;
      block-size: auto;
      overflow: visible;
    }
    .mascot-stop-a {
      stop-color: #fff3a8;
    }
    .mascot-stop-b {
      stop-color: #ffd23f;
    }
    .mascot-stop-c {
      stop-color: #ffaf3d;
    }
    .mascot-line {
      stroke: #e0a21b;
      stroke-width: 6;
      stroke-linecap: round;
      opacity: 0.6;
    }
    .mascot-tip {
      fill: #6b4a1f;
    }
    .mascot-skin {
      stroke: #3b2a10;
      stroke-width: 6;
      stroke-linejoin: round;
    }
    .mascot-eye {
      fill: #3b2a10;
    }
    .mascot-shine {
      fill: #fff;
    }
    .mascot-blush {
      fill: #ff9a8a;
      opacity: 0.75;
    }
    .mascot-mouth {
      stroke: #3b2a10;
      stroke-width: 6;
      stroke-linecap: round;
    }
    .mascot-star {
      fill: var(--c-accent);
    }
  }
</style>
