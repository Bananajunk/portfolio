---
// Time of day slider, presets and Calm mode toggle. Hidden until JS runs
// (html[data-js]); the stored choice is applied earlier by /theme-init.js.
---

<section
  class="mx-auto flex max-w-4xl flex-wrap items-center gap-x-8 gap-y-2 px-6 pt-3 text-step--1 text-ink-soft"
  aria-label="Display settings"
  data-controls
  data-testid="experience-controls"
>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-0">
    <label for="tod-slider" class="font-normal">Time of day</label>
    <input
      id="tod-slider"
      class="h-11 w-20 accent-accent"
      type="range"
      min="0"
      max="2"
      step="1"
      value="0"
      aria-valuetext="Day"
      data-tod-slider
      data-testid="time-of-day-slider"
    />
    <output for="tod-slider" class="sr-only" data-tod-value
      >Day</output
    >
    <div class="flex gap-0" role="group" aria-label="Time of day presets">
      {
        ["day", "dusk", "night"].map((theme) => (
          <button
            type="button"
            class="min-h-11 min-w-11 cursor-pointer border-0 bg-transparent px-2 font-text text-step--1 text-ink-soft aria-pressed:text-ink aria-pressed:underline aria-pressed:underline-offset-4"
            aria-pressed="false"
            data-theme-preset={theme}
            data-testid={`theme-preset-${theme}`}
          >
            {theme.charAt(0).toUpperCase() + theme.slice(1)}
          </button>
        ))
      }
    </div>
  </div>
  <label class="flex min-h-11 cursor-pointer items-center gap-2" for="calm-toggle">
    <input
      id="calm-toggle"
      class="m-0 h-4 w-4 accent-accent"
      type="checkbox"
      role="switch"
      data-calm-toggle
      data-testid="calm-toggle"
    />
    Calm mode
    <span class="sr-only">(turns off animation)</span>
  </label>
</section>

<script>
  import "../scripts/controls";
</script>
