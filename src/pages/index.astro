---
import About from "../components/About.astro";
import BeforeThat from "../components/BeforeThat.astro";
import ContactDock from "../components/ContactDock.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Stories from "../components/Stories.astro";
import Work from "../components/Work.astro";
import Base from "../layouts/Base.astro";
---

<Base
  title="Liam Reid | Senior Software Engineer | bananajunk.dev"
  description="Liam Reid is a senior full-stack engineer who leads product and accessibility work end to end. Email, LinkedIn, GitHub and Resume."
>
  <main id="main" tabindex="-1">
    <Hero />
    <Work />
    <Stories />
    <div class="mx-5 mt-12 grid max-w-[1100px] gap-7 border-0 border-t border-solid border-edge/50 pt-7 min-[761px]:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] min-[761px]:gap-14 min-[761px]:pt-9 min-[1140px]:mx-auto">
      <BeforeThat />
      <About />
    </div>
  </main>
  <Footer />
  <ContactDock />
</Base>
