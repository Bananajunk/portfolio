---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found | Liam Reid | bananajunk.dev"
  description="That page does not exist. Head back to Liam Reid's Site."
  noindex
  bare
>
  <main id="main" tabindex="-1" class="mx-auto max-w-4xl px-6 py-24 md:py-32" data-testid="not-found">
    <p class="font-display text-step-1 font-medium text-ink-soft">404</p>
    <h1 class="mt-3 font-display text-step-4 font-medium leading-none tracking-tight">
      Nothing here
    </h1>
    <p class="mt-7 max-w-prose text-step-0 text-ink-soft">
      This page wandered off. The link may be old or mistyped.
    </p>
    <p class="mt-7">
      <a class="inline-flex min-h-11 items-center text-accent underline decoration-1 underline-offset-4" href="/">
        Back to the Site
      </a>
    </p>
  </main>
</Base>
