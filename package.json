{
  "name": "bananajunk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-resume-drift.ts && astro build",
    "preview": "astro preview",
    "check": "astro check && biome check .",
    "check:launch": "node scripts/check-launch-ready.ts",
    "test": "node --test \"scripts/*.test.ts\"",
    "format": "biome check --write .",
    "deploy": "pnpm build && wrangler deploy"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.6",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "astro": "^7.4.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.158.0"
  }
}
